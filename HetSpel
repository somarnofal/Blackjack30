def toon_emailcheck_scherm():
    email_frame = tk.Frame(venster, bg="#222222", bd=10, relief="ridge", width=600, height=600)
    email_frame.place(relx=0.5, rely=0.5, anchor="center")

    tk.Label(email_frame, text="Login met e-mailadres", font=("Georgia", 18, "bold"), fg="gold", bg="#222222").pack(pady=20)
