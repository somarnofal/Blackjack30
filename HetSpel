def klik_ja():
    global speler_score, computer_score
    speler_score += random.randint(0, 3 if speler_score >= 20 else 10)
    computer_score += random.randint(0, 3 if computer_score >= 20 else 10)
    update_labels()
    if speler_score == 30:
        win_speler("  Je hebt exact 30! Jij wint!")
        return
    if computer_score == 30:
        verlies_speler("  Computer heeft exact 30! Jij verliest!")
        return
    check_winner()

def klik_nee():
    global computer_score
    computer_score += random.randint(0, 3 if computer_score >= 20 else 9)
    update_labels()
    if computer_score == 30:
        verlies_speler("  Computer heeft exact 30! Jij verliest!")
        return
    if speler_score == 30:
        win_speler("  Je hebt exact 30! Jij wint!")
        return
    check_winner(final=True)

def check_winner(final=False):
    if speler_score > 30 and computer_score > 30:
        gelijkspel("  Beide boven de 30! Gelijkspel!")
        return
    if speler_score > 30:
        verlies_speler("  Je bent boven de 30! Je verliest.")
        return
    if computer_score > 30:
        win_speler("  Computer is boven de 30! Jij wint!")
        return

    if final:
        ds = abs(30 - speler_score); dc = abs(30 - computer_score)
        if ds < dc:
            win_speler("  Je wint!")
        elif ds > dc:
            verlies_speler("  Computer wint!")
        else:
            gelijkspel("  Gelijkspel!")

def win_speler(msg):
    resultaat_label.config(image=win_emoji, text=msg, fg="green", compound="left")
    c.execute("""
        UPDATE spelers
        SET overwinningen = overwinningen + 1,
            credits = credits + 2
        WHERE email = ?
    """, (speler_email,))
    conn.commit()
    get_speler_stats()
    disable_buttons()

def verlies_speler(msg):
    resultaat_label.config(image=lose_emoji, text=msg, fg="red", compound="left")
    disable_buttons()

def gelijkspel(msg):
    resultaat_label.config(image=draw_emoji, text=msg, fg="#2a83be", compound="left")
    disable_buttons()

def disable_buttons():
    knop_ja.config(state="disabled")
    knop_nee.config(state="disabled")
    knop_opnieuw.pack(pady=15)
    knop_opnieuw.config(state="normal")

def opnieuw_spelen():
    global speler_score, computer_score
    speler_score = 0; computer_score = 0
    update_labels()
    resultaat_label.config(text="", image="")
    knop_ja.config(state="normal")
    knop_nee.config(state="normal")
    knop_opnieuw.pack_forget()
    knop_opnieuw.config(state="disabled")


