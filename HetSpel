def open_shop():
    shop = tk.Toplevel(venster); shop.title("Skins shop"); shop.config(bg="#222222")
    tk.Label(shop, text=f"💰 Jouw credits: {speler_credits}", font=("Georgia", 14, "bold"), fg="gold", bg="#222222").pack(pady=10)
    lijst = tk.Frame(shop, bg="#222222"); lijst.pack(padx=12, pady=6)

    c.execute("SELECT code, naam, prijs, icon FROM skins ORDER BY prijs ASC"); rows = c.fetchall()
    c.execute("SELECT skin_code FROM speler_skins WHERE speler_id = ?", (speler_id,)); owned = {r[0] for r in c.fetchall()}

    for code, naam, prijs, icon in rows:
        rij = tk.Frame(lijst, bg="#333333", bd=1, relief="groove"); rij.pack(fill="x", pady=5)
        tk.Label(rij, text=icon, font=("Georgia", 16), bg="#333333", fg="white").pack(side="left", padx=8)
        tk.Label(rij, text=f"{naam} — {prijs} credits", font=("Georgia", 12), bg="#333333", fg="white").pack(side="left", padx=8)

        if code in owned:
            tk.Button(rij, text=("In gebruik" if code == geselecteerde_skin else "Gebruik"),
                      font=("Georgia", 12), bg="#27ae60", fg="white",
                      command=lambda c=code: equip_skin(c, shop)).pack(side="right", padx=8)
        else:
            tk.Button(rij, text="Koop", font=("Georgia", 12), bg="#2980b9", fg="white",
                      command=lambda c=code, p=prijs: buy_skin(c, p, shop)).pack(side="right", padx=8)

def buy_skin(code, prijs, shop):
    global speler_credits
    if speler_credits < prijs:
        messagebox.showinfo("Onvoldoende credits", "Je hebt niet genoeg credits.")
        return
    c.execute("UPDATE spelers SET credits = credits - ? WHERE id = ?", (prijs, speler_id))
    c.execute("INSERT OR IGNORE INTO speler_skins (speler_id, skin_code) VALUES (?,?)", (speler_id, code))
    conn.commit()
    speler_credits -= prijs
    messagebox.showinfo("Succes", "Skin gekocht!")
    shop.destroy(); open_shop()

def equip_skin(code, shop=None):
    global geselecteerde_skin
    c.execute("SELECT 1 FROM speler_skins WHERE speler_id = ? AND skin_code = ?", (speler_id, code))
    if not c.fetchone():
        messagebox.showerror("Niet in bezit", "Je bezit deze skin niet.")
        return
    c.execute("UPDATE spelers SET selected_skin = ? WHERE id = ?", (code, speler_id)); conn.commit()
    geselecteerde_skin = code
    get_speler_stats()
    if shop:
        shop.destroy(); open_shop()


