        stap["index"] += 1

    def klik_ja_demo():
        clear_knoppen()
        extra_speler = random.randint(1, 6)
        extra_comp = random.randint(1, 6)
        scores["speler"] += extra_speler
        scores["computer"] += extra_comp
        speler_demo.config(text=f"Jouw score: {scores['speler']} (+{extra_speler})")
        computer_demo.config(text=f"Computer score: {scores['computer']} (+{extra_comp})")
        uitleg.config(text="Zie je? Jij en de computer kregen extra punten!")
        tk.Button(knop_frame, text="Volgende", command=volgende_stap, font=("Georgia", 14), bg="#246a41", fg="white").pack()

    def klik_nee_demo():
        clear_knoppen()
        extra_comp = random.randint(1, 6)
        scores["computer"] += extra_comp
        computer_demo.config(text=f"Computer score: {scores['computer']} (+{extra_comp})")
        uitleg.config(text="Omdat je stopte, kreeg de computer extra punten.\nJouw score bleef gelijk.\n\nNu bepaalt het spel wie er wint!")
        tk.Button(knop_frame, text="Volgende", command=volgende_stap, font=("Georgia", 14), bg="#246a41", fg="white").pack()

    def start_echt_spel():
        tutorial.pack_forget(); tutorial.place_forget(); regels_frame.pack_forget()
        start_game()

    tk.Button(knop_frame, text="Yes", command=volgende_stap, font=("Georgia", 14), bg="#246a41", fg="white").pack()

