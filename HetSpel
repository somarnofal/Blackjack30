            uitleg.config(text="Klik op JA om extra punten te krijgen!\nIk laat je zien wat er gebeurt...")
            tk.Button(knop_frame, text="JA", command=klik_ja_demo, font=("Georgia", 14), bg="#246a41", fg="white").pack()
        elif stap["index"] == 2:
            uitleg.config(text="Klik op NEE als je denkt dat je al dichter bij 30 zit.\nDan krijgt de computer nog punten.")
            tk.Button(knop_frame, text="NEE", command=klik_nee_demo, font=("Georgia", 14), bg="#a93226", fg="white").pack()
