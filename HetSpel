        naam_frame.place(relx=0.5, rely=0.5, anchor="center")

    bf = tk.Frame(email_frame, bg="#222222"); bf.pack(pady=20)
    tk.Button(bf, text="Inloggen", font=("Georgia", 14), bg="#246a41", fg="white",
              command=bevestig_email, width=12).grid(row=0, column=1, padx=10)
    tk.Button(bf, text="Registreren", font=("Georgia", 14), bg="#3498db", fg="white",
