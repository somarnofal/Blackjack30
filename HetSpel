            uitleg.config(text="In dit spel probeer je zo dicht mogelijk bij 30 te komen.\nGa je boven de 30, dan verlies je.")
            tk.Button(knop_frame, text="Volgende", command=volgende_stap, font=("Georgia", 14), bg="#246a41", fg="white").pack()
