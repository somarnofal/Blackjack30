    email_entry_check.pack(pady=10)

    fout_label_check = tk.Label(email_frame, text="", font=("Georgia", 11), bg="#222222", fg="red")
    fout_label_check.pack(pady=5)

    def bevestig_email():
        global speler_email, speler_credits
        email = email_entry_check.get().strip().lower()
        speler_email = email

        rij = c.execute("SELECT credits FROM spelers WHERE email = ?", (email,)).fetchone()
        if not rij:
            fout_label_check.config(text="E-mailadres niet gevonden. Registreer of probeer opnieuw.")
            return
        speler_credits = rij[0]

        c.execute("SELECT naam, overwinningen FROM spelers WHERE email = ?", (email,))
        rij = c.fetchone()
        if not rij:
            fout_label_check.config(text="E-mailadres niet gevonden. Registreer of probeer opnieuw.")
            return

        naam, mijn_wins = rij
        c.execute("SELECT COUNT(*) FROM spelers WHERE overwinningen > ?", (mijn_wins,))
        rang = c.fetchone()[0] + 1

        c.execute("SELECT naam, overwinningen FROM spelers ORDER BY overwinningen DESC LIMIT 1")
        beste = c.fetchone()
        extra = f"\nDe beste speler heeft {beste[1]} overwinningen!" if beste and beste[0] != naam else ""

        fout_label_check.config(text="")
