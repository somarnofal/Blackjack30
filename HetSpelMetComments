    computer_score = random.randint(0, 6)
    update_labels()

    # 🔥 Update speler stats bovenaan
    get_speler_stats()
    speler_info_label.config(
        text=f"👤 {speler_naam} | 🏆 {speler_wins} overwinningen | 📊 Rang: {speler_rang}"
    )

    knop_opnieuw.config(state="disabled")

def get_speler_stats():
    global speler_naam, speler_wins, speler_rang

    # Aantal overwinningen ophalen
    c.execute("SELECT naam, overwinningen FROM spelers WHERE email = ?", (speler_email,))
    rij = c.fetchone()
    if rij:
        speler_naam, speler_wins = rij
    else:
        speler_wins = 0

    # Ranking bepalen
    c.execute("SELECT COUNT(*) FROM spelers WHERE overwinningen > ?", (speler_wins,))
    hoger = c.fetchone()[0]
    speler_rang = hoger + 1

    # Label updaten
    speler_info_label.config(
        text=f"👤 {speler_naam} | 🏆 {speler_wins} overwiningen | 📊 Rang: {speler_rang}"
    )

# Boven 20 → beperkt risico:
# Als speler/computer ≥ 20 is, worden random getallen toegevoegd tussen 0–3 in plaats van 0–10.
# Update GUI: scores worden meteen zichtbaar.
# Directe winstcheck:
# Exact 30 is een onmiddellijke overwinning.
# Stop de knoppen met disable_buttons().
# Check winnaars: als niemand exact 30 heeft, ga verder met reguliere wincheck (check_winner()).
def klik_ja():
    global speler_score
    global computer_score

    # Bepaal range voor speler
    if speler_score >= 20:
        speler_score += random.randint(0, 3)
    elif speler_score >= 28:
        speler_score += random.randint(0, 1)
    else:
        speler_score += random.randint(0, 9)
    
    # Bepaal range voor computer
    if computer_score >= 20:
        computer_score += random.randint(0, 3)
    elif computer_score >= 28:
        computer_score += random.randint(0, 1)
    else:
        computer_score += random.randint(0, 9)
    
    update_labels()
    
    # Directe winstcheck bij 30
    if speler_score == 30:
        resultaat_label.config(image=win_emoji, text="  Je hebt exact 30! Jij wint!", fg="green", compound="left")
        disable_buttons()
        c.execute("UPDATE spelers SET overwinningen = overwinningen + 1 WHERE email = ?", (speler_email,))
        conn.commit()
        return
    elif computer_score == 30:
        resultaat_label.config(image=lose_emoji, text="  Computer heeft exact 30! Jij verliest!", fg="red", compound="left")
        disable_buttons()
        return
    
    check_winner()

# Als je stopt, krijgt de computer nog één laatste beurt.
# Scores worden aangepast volgens dezelfde regels (boven 20 → 0–3).
# Directe winstcheck voor exact 30.
# Als niemand precies 30 heeft, wordt de finale winnaar bepaald.
def klik_nee():
    global computer_score
    
    # Extra beurt computer
    if computer_score >= 20:
        computer_score += random.randint(0, 3)
        
    elif computer_score >= 28:
        computer_score += random.randint(0, 1)    

    else:
        computer_score += random.randint(0, 9)
        
    
    update_labels()
    
    # Directe winstcheck bij 30
    if computer_score == 30:
        resultaat_label.config(image=lose_emoji, text="  Computer heeft exact 30! Jij verliest!", fg="red", compound="left")
        disable_buttons()
        return
    elif speler_score == 30:
        resultaat_label.config(image=win_emoji, text="  Je hebt exact 30! Jij wint!", fg="green", compound="left")
        disable_buttons()
        return
    
    check_winner(final=True)

# Beide boven 30 → gelijkspel.
# Eén boven 30 → verlies/winst.
# final=True → speler heeft gekozen te stoppen → dichtst bij 30 wint.
def check_winner(final=False):
    if speler_score > 30 and computer_score > 30:
        resultaat_label.config(image=draw_emoji, text="  Beide boven de 30! Gelijkspel!", fg="blue", compound="left")
        disable_buttons()
    elif speler_score > 30:
        resultaat_label.config(image=lose_emoji, text="  Je bent boven de 30! Je verliest.", fg="red", compound="left")
        disable_buttons()
    elif computer_score > 30:
        resultaat_label.config(image=win_emoji, text="  Computer is boven de 30! Jij wint!", fg="green", compound="left")
        disable_buttons()
        c.execute("UPDATE spelers SET overwinningen = overwinningen + 1 WHERE email = ?", (speler_email,))
        conn.commit()
        get_speler_stats()
    elif final:
        if abs(30 - speler_score) < abs(30 - computer_score):
            resultaat_label.config(image=win_emoji, text="  Je wint!", fg="green", compound="left")
            c.execute("UPDATE spelers SET overwinningen = overwinningen + 1 WHERE email = ?", (speler_email,))
            conn.commit()
            get_speler_stats()
        elif abs(30 - speler_score) > abs(30 - computer_score):
            resultaat_label.config(image=lose_emoji, text="  Computer wint!", fg="red", compound="left")
        else:
            resultaat_label.config(image=draw_emoji, text="  Gelijkspel!", fg="blue", compound="left")
        disable_buttons()

# Knoppen “Ja” en “Nee” worden uitgeschakeld.
# Knop “Opnieuw spelen” wordt beschikbaar.
def disable_buttons():
    knop_ja.config(state="disabled")
    knop_nee.config(state="disabled")
    knop_opnieuw.pack(pady=15)
    knop_opnieuw.config(state="normal")

