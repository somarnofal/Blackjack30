    resultaat_label.config(text="", image="")  #  Reset afbeelding
    game_frame.pack(pady=20)
    game_frame.place(relx=0.5, rely=0.4, anchor="center")
    # regels_frame.pack(pady=20)   # verwijder game scherm
    knop_ja.config(state="normal")
    knop_nee.config(state="normal")
    knop_opnieuw.pack_forget()           # Knop weer verbergen
    knop_opnieuw.config(state="disabled")


